import React, { useState } from 'react';
import MessageList from './MessageList'; // Asume que ya tienes este componente
import MessageInput from './MessageInput';

const ChatContainer = () => {
  const [messages, setMessages] = useState([]);

  // Esta es la función que se le pasa como prop al MessageInput
  const handleNewMessage = (newMessageText) => {
    // Creamos un nuevo objeto de mensaje con un ID, el texto y un emisor
    const newMessage = {
      id: messages.length + 1,
      text: newMessageText,
      sender: 'user', // O un ID de usuario real
    };

    // Actualizamos el estado de la lista de mensajes
    setMessages([...messages, newMessage]);
  };

  return (
    <div className="chat-container">
      <MessageList messages={messages} />
      {/* Pasamos la función `handleNewMessage` como la prop `onSendMessage` */}
      <MessageInput onSendMessage={handleNewMessage} />
    </div>
  );
};

export default ChatContainer;